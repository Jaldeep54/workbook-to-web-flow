# ---------------------------------------------------------------------------
# Klinzo Operations API — backend environment
#
# Copy to `.env` and fill in. Nothing here is ever exposed to the browser: the
# frontend only knows the API's base URL. The process refuses to start if a
# required value is missing or too weak, rather than falling back to a default.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Local:   mongodb://127.0.0.1:27017/klinzo_ops
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/klinzo_ops?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/klinzo_ops
# Optional — only needed when the database name isn't in the URI.
MONGODB_DB_NAME=
# Connections held per process. Keep the default on a long-lived server; drop
# it to ~5 on a serverless host, where many short-lived instances share the
# cluster's connection limit.
MONGODB_MAX_POOL_SIZE=20

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use two different values, and different values per environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- CORS and cookies ------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API with
# credentials. Never use "*" — the refresh token travels in a cookie.
CORS_ORIGINS=http://localhost:8080
# Set in production when the API and app share a parent domain.
COOKIE_DOMAIN=
# Leave blank to follow NODE_ENV (secure cookies in production).
COOKIE_SECURE=

# --- Uploads ---------------------------------------------------------------
# Where shop photos live, served either way through short-lived signed URLs.
#   disk   — under UPLOAD_DIR; needs a persistent volume.
#   gridfs — inside MongoDB; the only option on a read-only serverless
#            filesystem, and the default when VERCEL is set.
FILE_STORAGE=disk
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
FILE_URL_TTL_SECONDS=3600
# Defaults to JWT_ACCESS_SECRET when blank.
FILE_URL_SECRET=

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# --- Seed administrator ----------------------------------------------------
# Created by `npm run seed` if it doesn't already exist. Change the password
# after the first sign-in (an existing account's password is never reset by a
# re-seed).
ADMIN_EMAIL=noobgaming2907@gmail.com
ADMIN_PASSWORD=Dipak@123
ADMIN_FULL_NAME=Klinzo Administrator

# --- One-off Supabase migration -------------------------------------------
# Only needed while running `npm run migrate`. Remove afterwards — the service
# role key bypasses every Supabase security rule.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
