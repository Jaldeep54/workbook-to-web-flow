{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:rest*", "destination": "/api?rest=:rest*" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
