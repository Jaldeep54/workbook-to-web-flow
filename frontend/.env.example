# ---------------------------------------------------------------------------
# Klinzo Operations web client — frontend environment
#
# Every VITE_ variable is compiled into the browser bundle and is therefore
# PUBLIC. Only values that are safe for anyone to read belong here — never a
# database URI, never a JWT secret, never an API key that isn't origin-locked.
# ---------------------------------------------------------------------------

# Base URL of the Klinzo Operations API, including the version prefix. May be
# absolute, or origin-relative when the host rewrites /api to the API — which
# is what the Vercel setup does, so the refresh cookie stays first-party.
# Development: http://localhost:4000/api/v1
# Vercel:      /api/v1
# Split hosts: https://api.your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google Maps Platform key for the shop location picker and "Shops on Map".
# Restrict it in Google Cloud Console to your domain(s) (HTTP referrers) and to
# the Maps JavaScript, Places and Geocoding APIs — see the README.
VITE_GOOGLE_MAPS_API_KEY=
